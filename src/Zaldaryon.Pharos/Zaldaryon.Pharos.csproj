<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Zaldaryon.Pharos</RootNamespace>
    <AssemblyName>Zaldaryon.Pharos</AssemblyName>

    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and Exists('C:\Games\VintageStory')">C:\Games\VintageStory</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../../.vanilla/win-x64/vintagestory')">$(MSBuildThisFileDirectory)../../../.vanilla/win-x64/vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zaldaryon.Pharos.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)/VintagestoryLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Core">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Audio.OpenAL">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Audio.OpenAL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VintageStoryPath)/Lib/cairo-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)/Lib/SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(VintageStoryPath)\Lib\glfw3.dll" Condition="Exists('$(VintageStoryPath)\Lib\glfw3.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(VintageStoryPath)\Lib\libSkiaSharp.dll" Condition="Exists('$(VintageStoryPath)\Lib\libSkiaSharp.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(VintageStoryPath)\Lib\OpenAL32.dll" Condition="Exists('$(VintageStoryPath)\Lib\OpenAL32.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
