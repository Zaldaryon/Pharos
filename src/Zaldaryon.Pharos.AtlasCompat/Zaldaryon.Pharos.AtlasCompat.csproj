<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zaldaryon.Pharos.AtlasCompat</RootNamespace>
    <AssemblyName>Zaldaryon.Pharos.AtlasCompat</AssemblyName>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <PackageId>Zaldaryon.Pharos.AtlasCompat</PackageId>
    <Version>0.1.0</Version>
    <Authors>Zaldaryon</Authors>
    <Description>Drop-in compatibility shim for migrating from Pixnop.Atlas to Zaldaryon.Pharos.XUnit. Provides type aliases in Atlas.Api and Atlas.XUnit namespaces that delegate to native Pharos types.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Zaldaryon/Pharos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vintagestory;testing;headless;xunit;migration;atlas;compatibility</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Zaldaryon.Pharos/Zaldaryon.Pharos.csproj" />
    <ProjectReference Include="../Zaldaryon.Pharos.XUnit/Zaldaryon.Pharos.XUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.core" Version="2.9.3" />
  </ItemGroup>
</Project>
